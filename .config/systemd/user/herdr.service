[Unit]
Description=Herdr headless terminal workspace server
Documentation=https://herdr.dev/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=HOME=/home/takashi
Environment=PATH=/home/takashi/.local/bin:/home/takashi/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/takashi/.local/bin/herdr server
ExecStop=/home/takashi/.local/bin/herdr server stop
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=default.target
