#!/usr/bin/env bash
set -euo pipefail

operation="${1:-}"

case "$operation" in
    get)
        protocol=""
        host=""

        while IFS='=' read -r key value; do
            case "$key" in
                protocol) protocol="$value" ;;
                host) host="$value" ;;
            esac
        done

        # GitHub にだけこの credential helper を使う。
        if [[ "$protocol" == "https" && "$host" == "github.com" ]]; then
            printf 'username=x-access-token\n'
            printf 'password=%s\n' "$("$HOME/bin/github-app-token")"
        fi
        ;;

    store|erase)
        # installation token は短命なので保存しない。
        ;;

    *)
        exit 1
        ;;
esac

